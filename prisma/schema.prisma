generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MonitorConfig {
  id                   Int      @id
  refreshSeconds       Int
  minOpportunityScore  Int
  regions              String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model LeadGenConfig {
  id               Int      @id
  consentRequired  Boolean
  firstPartyOnly   Boolean
  allowedChannels  String
  suppressionList  String
  targetSectors    String
  minCompanySize   Int
  maxCompanySize   Int
  minOpportunityValue Int
  preferredSignalTypes String
  timeWindowDays   Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TrackedEntity {
  id         String   @id
  name       String
  role       String
  keywords   String
  countries  String
  services   String
  sector     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PipelineState {
  id        Int      @id
  payload   String
  updatedAt DateTime @updatedAt
}
